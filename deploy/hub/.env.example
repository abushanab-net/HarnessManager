# The name the computers will use; its A/AAAA record must point at this VPS before `compose up`
HUB_DOMAIN=hub.example.com
# Joins the first computer and may forget any; make it long and random: `openssl rand -hex 32`
HUB_ADMIN_TOKEN=
# Optional: the image tag (a release, e.g. 1.6.0), the biggest chunk or transcript, and how much journal
# the hub keeps per computer before dropping the oldest chunks
#HUB_TAG=latest
#HUB_MAX_BLOB_MB=64
#HUB_RETAIN_MB=2048
