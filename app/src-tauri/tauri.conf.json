{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Harness Manager",
  "version": "1.3.0",
  "identifier": "net.abushanab.harnessmanager",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Run AI coding tools under several accounts side by side",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "mainBinaryName": "HarnessManager",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIxMUFEN0Y2NkREQjc5OEYKUldTUGVkdHQ5dGNhc1hoREpGMEk5TlVmSXA4cjRESzJpeVI1TDhzU0tsVHovd1dmSEpiTDFXM0UK",
      "endpoints": [
        "https://github.com/abushanab-net/HarnessManager/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
